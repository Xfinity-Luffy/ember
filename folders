# Builds the Ember iPhone app on a GitHub-hosted Mac and publishes an unsigned
# Ember.ipa you can install from Windows with Sideloadly.
# Works whether the files are in folders (ios/...) or all uploaded loose at the top.

name: Build iPhone app

on:
  workflow_dispatch:
  push:

jobs:
  build:
    runs-on: macos-26
    timeout-minutes: 30

    steps:
      - name: Get the code
        uses: actions/checkout@v4

      - name: Put loose files into folders
        run: |
          if [ ! -d ios/Ember ]; then
            mkdir -p ios/Ember/Assets.xcassets/AppIcon.appiconset ios/tools
            mv ./*.swift ios/Ember/
            mv project.yml ios/
            mv make_icon.py ios/tools/
            printf '%s\n' '{ "info" : { "author" : "xcode", "version" : 1 } }' > ios/Ember/Assets.xcassets/Contents.json
            printf '%s\n' '{' \
              '  "images" : [' \
              '    { "filename" : "icon.png", "idiom" : "universal", "platform" : "ios", "size" : "1024x1024" }' \
              '  ],' \
              '  "info" : { "author" : "xcode", "version" : 1 }' \
              '}' > ios/Ember/Assets.xcassets/AppIcon.appiconset/Contents.json
          fi
          find ios -type f | sort

      - name: Show Xcode version
        run: xcodebuild -version

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Draw app icon
        working-directory: ios
        run: python3 tools/make_icon.py Ember/Assets.xcassets/AppIcon.appiconset/icon.png

      - name: Generate Xcode project
        working-directory: ios
        run: xcodegen generate

      - name: Build app (unsigned)
        working-directory: ios
        run: |
          set -o pipefail
          xcodebuild \
            -project Ember.xcodeproj \
            -scheme Ember \
            -configuration Release \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -derivedDataPath build \
            CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
            build | tee xcodebuild.log | grep -E "error:|warning: .*Ember|BUILD (SUCCEEDED|FAILED)" || true
          test -d build/Build/Products/Release-iphoneos/Ember.app

      - name: Package Ember.ipa
        working-directory: ios
        run: |
          mkdir -p Payload
          cp -R build/Build/Products/Release-iphoneos/Ember.app Payload/
          zip -qry Ember.ipa Payload
          ls -lh Ember.ipa

      - name: Upload Ember.ipa
        uses: actions/upload-artifact@v4
        with:
          name: Ember-ipa
          path: ios/Ember.ipa
          retention-days: 30

      - name: Upload build log (if something failed)
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-log
          path: ios/xcodebuild.log
